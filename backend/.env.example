# Copy to .env and fill in values. Never commit .env.
DATABASE_URL=postgresql+psycopg2://postgres:password@db.supabase.co:5432/postgres
JWT_SECRET=change-me-super-secret-32chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ENCRYPTION_KEY=generate-with-python-cryptography-fernet-key
SUPABASE_URL=https://xyz.supabase.co
SUPABASE_KEY=supabase-anon-or-service-key
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-backend/gmail/callback
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
FCM_CREDENTIALS_JSON=./firebase-service-account.json
FRONTEND_URL=finmate://oauth/callback
CORS_ORIGINS=*
